@startuml SequenceDiagram1_CompleteWorkItem
' Sequence Diagram 1 - Completing a work item and determining what happens next
' Owner: Envy. Updated for the final project to match the C++ classes.
skinparam defaultFontName Arial
skinparam ParticipantBackgroundColor #7FD3F7
skinparam ParticipantBorderColor #2B6F8E
skinparam SequenceGroupBackgroundColor #FFFFFF
autonumber "0."
title Sequence Diagram 1: Complete a work item and route the next work

actor Client
participant ":WorkflowEngine" as Engine
participant ":HistoryManager" as History
participant "instance:WorkflowInstance" as Instance
participant "cmd:CompleteCommand" as Cmd
participant ":AccessControlProxy" as Proxy
participant "item:WorkItem" as Item
participant ":StartedState" as State
participant ":EventListener" as Listener
participant "tracker:ProgressionTracker" as Tracker
participant ":DataBasedRouting" as Routing
participant ":RoutingCondition" as Condition
participant ":DependencyGraph" as Deps
participant ":AssignmentRule" as Assign

Client -> Engine : completeWorkItem(instanceId, workItemId)
activate Engine
Engine -> History : saveState()
activate History
History -> Instance : createSnapshot()
create participant ":InstanceSnapshot" as Snap
Instance -> Snap : <<create>>
Instance --> History : snapshot
deactivate History

create Cmd
Engine -> Cmd : <<create>> (item, actor)
Engine -> Cmd : execute()
activate Cmd
Cmd -> Proxy : request()
activate Proxy
alt actor is allowed by the AccessPolicy
  Proxy -> Item : request()
  activate Item
  Item -> State : complete(item)
  activate State
  State -> Item : changeState(CompletedState)
  deactivate State
  Item -> Item : notifyListeners()
  loop for each attached listener
    Item -> Listener : update(event)
  end
  Item --> Proxy
  deactivate Item
  Proxy --> Cmd
else actor is not allowed
  Proxy --> Cmd : refused (item never reached)
end
deactivate Proxy
Cmd --> Engine : done
deactivate Cmd

Engine -> Instance : completeWorkItem(item)
activate Instance
Instance -> Tracker : complete(itemName, instanceData)
activate Tracker
alt item is not available work
  Tracker --> Instance : std::logic_error (progress unchanged)
else item is available
  Tracker -> Routing : determineNextWork(itemName, instanceData)
  activate Routing
  alt item is a decision point
    loop each branch, in order, until a guard holds
      Routing -> Condition : evaluate(instanceData)
      Condition --> Routing : bool
    end
    Routing --> Tracker : RoutingDecision (matching branch or default)
  else item has a fixed path
    Routing --> Tracker : RoutingDecision (sequence or parallel split)
  end
  deactivate Routing
  Tracker -> Tracker : mark item complete
  loop each nominated item
    Tracker -> Deps : isSatisfied(next, completed)
    Deps --> Tracker : bool
    Tracker -> Tracker : add to available or waiting
  end
  loop each waiting item
    Tracker -> Deps : isSatisfied(waitingItem, completed)
    Deps --> Tracker : bool
  end
  Tracker --> Instance : ProgressionResult
end
deactivate Tracker

loop each item in result.madeAvailable
  Instance -> Item : getCurrentState()->makeAvailable(next)
  Instance -> Assign : assignParticipant(next, participants)
  Assign --> Instance : participant
end
opt result.instanceComplete
  Instance -> Instance : mark instance complete
end
Instance --> Engine
deactivate Instance
Engine --> Client : work item completed
deactivate Engine
@enduml
